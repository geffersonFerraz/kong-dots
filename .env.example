# Copy to .env and adjust. Compose reads .env automatically.

# AES-GCM key protecting the Admin API credentials stored in PostgreSQL.
# Generate one with: openssl rand -base64 32
# Losing this value makes every stored credential unreadable.
KONGFLOW_SECRET_KEY=

# Browser origins allowed to call the API (comma-separated). Only needed when
# the UI is served from a different origin than the backend — the SPA served by
# the binary itself is always allowed.
KONGFLOW_CORS_ORIGINS=

# Who may push a change to a real Kong. While both are empty, everyone applies
# directly — which is what a single-operator install wants. Set them and every
# other editor's "Apply" is filed as a change request instead, waiting for one of
# these people to review it.
#
# The token is the part that actually authenticates: with it set, approving needs
# both the token and a name from the list. A name on its own is a convention
# inside a trusted team, not a control — put SSO or an authenticating proxy in
# front of this before it guards production.
KONGFLOW_APPROVERS=
KONGFLOW_APPROVER_TOKEN=

# PostgreSQL 18 holding the tool's own state. Compose builds this URL from the
# three variables below for the bundled `db` service; set KONGFLOW_DATABASE_URL
# directly to point the backend at a database you already run.
KONGFLOW_DB_USER=kongflow
KONGFLOW_DB_PASSWORD=kongflow
KONGFLOW_DB_NAME=kongflow
# KONGFLOW_DATABASE_URL=postgres://kongflow:kongflow@localhost:5432/kongflow?sslmode=disable

# Address the published ports bind to. Loopback by default, so nothing is
# reachable from the network until you say so. Set 0.0.0.0 to reach the UI (and
# the Kong proxy, in the demo stack) from another machine on the LAN — useful
# for trying the shared canvas with two people, and not something to leave on.
#
# It never opens Kong's Admin API or PostgreSQL: those stay on loopback, because
# the Admin API has no authentication here and is full control of the gateway.
KONGFLOW_BIND=127.0.0.1

# Host ports used by the demo stack (deploy/demo.yml).
KONGFLOW_PORT=8080
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONGFLOW_DB_PORT=5432
