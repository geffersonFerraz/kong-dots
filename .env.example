# Copy to .env and adjust. Compose reads .env automatically.

# AES-GCM key protecting the Admin API credentials stored in PostgreSQL.
# Generate one with: openssl rand -base64 32
# Losing this value makes every stored credential unreadable.
KONGDOTS_SECRET_KEY=

# Browser origins allowed to call the API (comma-separated). Only needed when
# the UI is served from a different origin than the backend — the SPA served by
# the binary itself is always allowed.
KONGDOTS_CORS_ORIGINS=

# PostgreSQL 18 holding the tool's own state. Compose builds this URL from the
# three variables below for the bundled `db` service; set KONGDOTS_DATABASE_URL
# directly to point the backend at a database you already run.
KONGDOTS_DB_USER=kongdots
KONGDOTS_DB_PASSWORD=kongdots
KONGDOTS_DB_NAME=kongdots
# KONGDOTS_DATABASE_URL=postgres://kongdots:kongdots@localhost:5432/kongdots?sslmode=disable

# Host ports used by the demo stack (deploy/demo.yml).
KONGDOTS_PORT=8080
KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONGDOTS_DB_PORT=5432
